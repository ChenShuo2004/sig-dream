# Generate .env with npm run access:init. Do not use this example as a real secret.
SIG_DREAM_ACCESS_USER=sig-dream
SIG_DREAM_ACCESS_PASSWORD=
# Enable behind an HTTPS reverse proxy.
SIG_DREAM_SECURE_COOKIE=1
# Docker Compose host binding; only change after adding TLS and access controls.
BIND_ADDRESS=127.0.0.1
