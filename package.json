{
    "name": "sig-dream",
    "version": "0.3.4",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1 --port 3000",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "test": "node --test tests/*.test.ts",
        "test:smoke": "node scripts/smoke-test.mjs",
        "demos:render": "node scripts/render-demos.mjs",
        "start": "node server/index.mjs",
        "start:open": "node server/index.mjs --open",
        "build:portable": "npm run build:agent && npm run build && node scripts/build-portable.mjs",
        "desktop:dev": "npm run build:agent && npm run build && npm --prefix desktop start",
        "desktop:dir": "npm run build:agent && npm run build && npm --prefix desktop run pack:dir",
        "desktop:mac": "npm run build:agent && npm run build && npm --prefix desktop run dist:mac",
        "desktop:win": "npm run build:agent && npm run build && npm --prefix desktop run dist:win",
        "desktop:linux": "npm run build:agent && npm run build && npm --prefix desktop run dist:linux",
        "version:sync": "node scripts/sync-version.mjs",
        "verify:release": "node scripts/verify-release.mjs",
        "preview": "vite preview --host 127.0.0.1 --port 3000",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:agent:ui": "node scripts/test-agent-connections.mjs",
        "test:agent:bridge": "node scripts/test-agent-bridge.mjs",
        "test:portable": "node scripts/test-portable.mjs",
        "test:desktop": "node scripts/test-desktop.mjs",
        "build:agent": "node scripts/build-agent.mjs",
        "access:init": "node scripts/create-access-config.mjs",
        "test:public": "node scripts/test-public-access.mjs",
        "desktop:release": "node desktop/scripts/package-release.mjs",
        "predev": "npm run build:agent",
        "prestart": "npm run build:agent"
    },
    "dependencies": {
        "@ant-design/icons": "^6.1.1",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@tanstack/react-query": "^5.100.9",
        "@uiw/react-codemirror": "^4.25.9",
        "antd": "^6.4.2",
        "axios": "^1.16.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "copy-to-clipboard": "^4.0.2",
        "dayjs": "^1.11.20",
        "fflate": "^0.8.3",
        "file-saver": "^2.0.5",
        "i18next": "^26.3.6",
        "localforage": "^1.10.0",
        "lucide-react": "^1.16.0",
        "mediabunny": "^1.61.6",
        "motion": "^12.38.0",
        "nanoid": "^5.1.11",
        "radix-ui": "^1.4.3",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "react-i18next": "^17.0.11",
        "react-router": "^7.12.0",
        "react-router-dom": "^7.12.0",
        "streamdown": "2.8.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4",
        "tw-animate-css": "^1.4.0",
        "wavesurfer.js": "^7.12.12",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@sig-dream/canvas-agent": "file:packages/canvas-agent",
        "@tailwindcss/postcss": "^4",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^20",
        "@types/react": "19.1.12",
        "@types/react-dom": "19.1.9",
        "@vitejs/plugin-react": "^5.2.0",
        "playwright": "1.65.1",
        "prettier": "^3.8.3",
        "typescript": "^5",
        "vite": "^7.3.0",
        "zod": "4.6.7"
    }
}
