{
  "name": "light-content-desktop-client",
  "version": "0.2.0",
  "description": "sig-dream desktop client",
  "author": {
    "name": "ChenShuo2004",
    "email": "220584709+ChenShuo2004@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ChenShuo2004/sig-dream.git"
  },
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run electron:dev",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:pack": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --config electron-builder.yml",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64 --config electron-builder.yml",
    "dist:publish:win": "npm run build && electron-builder --win --x64 --config electron-builder.yml --publish always",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "dist:linux": "npm run build && electron-builder --linux --x64 --config electron-builder.yml",
    "dist:all": "npm run build && electron-builder --win --mac --linux --config electron-builder.yml"
  },
  "build": {
    "extends": "electron-builder.yml"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "gifenc": "^1.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "homepage": "https://github.com/ChenShuo2004/sig-dream"
}
