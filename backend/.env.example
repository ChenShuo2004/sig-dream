DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/light_content
# JWT signing secret (set a strong unique value in production; rotates all sessions when changed)
TOKEN_SECRET=change-this-jwt-token-secret
NAS_CLIENT_TOKEN=change-this-nas-client-token
NAS_BASE_URL=http://127.0.0.1:8000
NAS_MOUNT_ROOT=
# 文件机 HTTP 根（无尾斜杠）。无 nas_file_service_nodes 心跳时 download-route 用此回退；部署可由 local-env 中 DEPLOY_LAN_* 合并写入。
LAN_DOWNLOAD_BASE_URL=http://127.0.0.1:9001
LAN_UPLOAD_BASE_URL=http://127.0.0.1:9001
# 可选：浏览器经公网直连文件机（与 LAN 分离）；多机时优先用心跳写入注册表
PUBLIC_DOWNLOAD_BASE_URL=
PUBLIC_UPLOAD_BASE_URL=
# 单文件机：NAS 心跳/poll/票据校验等请求上，若 public_* 未显式配置，用入站公网 IP + LAN 端口推断公网直连根（设为 false 则仅用手动 PUBLIC_* / 心跳字段）
FILE_SERVICE_INFER_PUBLIC_FROM_INGRESS=true
FILE_SERVICE_POLL_BOOTSTRAP_REGISTRY=true
FILE_SERVICE_BOOTSTRAP_NODE_ID=default-file-machine
DOWNLOAD_TICKET_SECRET=change-this-download-ticket-secret
DOWNLOAD_TICKET_TTL_SECONDS=600
UPLOAD_TICKET_TTL_SECONDS=900
DOWNLOAD_CACHE_TTL_SECONDS=1800
