{
  "name": "sig-dream-desktop",
  "version": "0.3.3",
  "description": "sig-dream · Zero-database, local-first AI infinite canvas & creative studio desktop app",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "author": {
    "name": "ChenShuo2004",
    "email": "220584709+ChenShuo2004@users.noreply.github.com"
  },
  "homepage": "https://github.com/ChenShuo2004/sig-dream",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChenShuo2004/sig-dream.git"
  },
  "scripts": {
    "start": "node -e \"delete process.env.ELECTRON_RUN_AS_NODE; import('node:child_process').then(async ({ spawn }) => { const { default: electronPath } = await import('electron'); spawn(electronPath, ['.'], { stdio: 'inherit', env: process.env }).on('exit', (c) => process.exit(c ?? 0)); })\"",
    "pack:dir": "electron-builder --dir --config electron-builder.yml --publish never",
    "dist:mac": "electron-builder --mac --x64 --arm64 --config electron-builder.yml --publish never",
    "dist:mac:arm64": "electron-builder --mac --arm64 --config electron-builder.yml --publish never",
    "dist:mac:x64": "electron-builder --mac --x64 --config electron-builder.yml --publish never",
    "dist:win": "electron-builder --win --x64 --config electron-builder.yml --publish never",
    "dist:linux": "electron-builder --linux --x64 --config electron-builder.yml --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.9"
  }
}
